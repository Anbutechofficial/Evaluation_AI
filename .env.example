# ============================================================
# EduEval AI Environment Configuration
# ============================================================

# Application
PROJECT_NAME="Evaluation AI"
VERSION="1.0.0"

# Security & JWT
JWT_SECRET="edueval_ai_super_secret_jwt_key_2026_production_grade"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (PostgreSQL for Docker/Production, SQLite for zero-config local run)
DATABASE_URL="sqlite:///./edueval.db"
# DATABASE_URL="postgresql://postgres:edueval_password@localhost:5432/edueval_db"

# GenAI Inference Provider (auto / openai / gemini / heuristic)
LLM_PROVIDER="auto"
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Vector Database & RAG
VECTOR_DB_TYPE="in_memory" # in_memory / faiss / qdrant
VECTOR_DB_URL=""

# Evaluation Confidence Gate
CONFIDENCE_THRESHOLD=0.70
